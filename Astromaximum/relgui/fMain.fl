decl {extern void set_year(const char*);} {} 

decl {extern void cb_unselect(MyBrowser*, void*);} {} 

decl {extern void cb_select(MyBrowser*, void*);} {} 

decl {extern void cb_sort(fltk::RadioButton*, void*);} {} 

decl {extern void cb_do_imei(fltk::Button*, void*);} {} 

decl {extern void cb_do_timebomb(fltk::Button*, void*);} {} 

decl {extern void cb_do_demo(fltk::Button*, void*);} {} 

decl {extern void cb_do_geo(fltk::Button*, void*);} {} 

decl {\#include "fltk/events.h"} {} 

decl {\#include "fltk/Browser.h"} {public
} 

decl {\#include "fltk/IntInput.h"} {public
} 

class MyBrowser {open : {public fltk::Browser}
} {
  Function {handle(int event)} {open private return_type int attributes virtual
  } {
    code {if(event==fltk::PUSH){
	if(fltk::event_clicks()>1){
		fltk::event_clicks(0);
		do_callback();
		return true;
	}
	else{
		return fltk::Browser::handle(event);
	}
}
else{
	return fltk::Browser::handle(event);
}} {}
  }
  Function {MyBrowser(int x, int y, int w, int h, const char *l):fltk::Browser(x, y, w, h, l)} {open
  } {
    code {when(fltk::WHEN_ENTER_KEY_ALWAYS);} {}
  }
} 

decl {extern void cb_load_loclist(fltk::Button*, void*);} {} 

decl {extern void cb_save_loclist(fltk::Button*, void*);} {} 

decl {extern void cb_clear_loclist(fltk::Button*, void*);} {} 

Function {make_window()} {open
} {
  {fltk::Window} {} {open
    xywh {55 152 950 535} resizable visible
  } {
    {fltk::Group} {} {open
      xywh {210 5 735 525} box THIN_DOWN_BOX buttonbox NO_BOX
    } {
      {fltk::Browser} lbSelected {
        label Selected
        callback cb_unselect open
        xywh {5 20 350 505}
        class MyBrowser
      } {}
      {fltk::Browser} lbAvailable {
        label Available
        callback cb_select open
        xywh {360 20 370 505}
        class MyBrowser
      } {}
    }
    {fltk::Group} {} {open
      xywh {5 5 206 530}
    } {
      {fltk::Group} {} {open selected
        xywh {0 0 206 220} box THIN_DOWN_BOX
      } {
        {fltk::Input} txtYear {
          callback {if(bSetYear->active())
    set_year(txtYear->text());}
          xywh {5 5 85 20} when ENTER_KEY
          class {fltk::IntInput}
        }
        {fltk::Button} bSetYear {
          label {Set year}
          callback {set_year(txtYear->text());}
          xywh {109 5 85 20}
        }
        {fltk::PopupMenu} pbLang {
          callback {o->label(o->get_item()->label());}
          xywh {5 28 85 25} align 48
          extra_code {o->add("EN");
o->add("RU");
o->add("UA");
o->value(1);
o->label(o->get_item()->label());}
        } {}
        {fltk::Button} {} {
          label Demo
          callback cb_do_demo
          xywh {110 28 84 25}
        }
        {fltk::Input} txtImei {
          label {IMEI:}
          callback cb_imei_changed
          xywh {35 55 160 25} when CHANGED
          class {fltk::IntInput}
        }
        {fltk::Button} bImei {
          label IMEI
          callback cb_do_imei
          xywh {5 85 85 25}
        }
        {fltk::Button} bImeiLogger {
          label {IMEI logger}
          callback cb_do_imei
          xywh {110 85 85 25}
          extra_code {o->user_data((void*)1);}
        }
        {fltk::Input} txtTimeOffset {
          label {Timeshift, hrs:}
          xywh {5 130 95 25} align 1 deactivate
          extra_code {o->text("0");}
          class {fltk::IntInput}
        }
        {fltk::Input} txtTimeDelta {
          label {Delta, min:}
          xywh {5 170 95 25} align 1
          extra_code {o->text("30");}
          class {fltk::FloatInput}
        }
        {fltk::Button} {} {
          label {Time bomb}
          callback cb_do_timebomb
          xywh {110 135 85 50} align 128
        }
        {fltk::CheckButton} ckDebug {
          label Debug
          xywh {5 195 65 25} deactivate
        }
        {fltk::CheckButton} ckMessjar {
          label Messjar
          xywh {125 195 72 25} value 1
        }
      }
      {fltk::Group} {} {open
        xywh {0 225 200 150} resizable
      } {
        {fltk::Output} lbLoclist {
          xywh {0 8 200 18} textsize 9
        }
        {fltk::Button} {} {
          label Load
          callback cb_load_loclist
          xywh {50 35 95 25}
        }
        {fltk::Button} {} {
          label Save
          callback cb_save_loclist
          xywh {50 65 95 25}
        }
        {fltk::Button} {} {
          label Clear
          callback cb_clear_loclist
          xywh {50 110 95 25}
        }
      }
      {fltk::Group} {} {open
        xywh {0 375 200 150}
      } {
        {fltk::Group} {} {
          label {Sort by:} open
          xywh {5 75 190 35} box FLAT_BOX
        } {
          {fltk::RadioButton} {} {
            label City
