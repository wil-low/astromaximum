  <target name="make.kzip" if="need.kzip" description="Kzip instead of Jar">
    <delete includeEmptyDirs="true" quiet="true">
      <fileset dir=".temp"/>
    </delete>
    <mkdir dir=".temp/META-INF"/>
    <copy file="${build.dir}/manifest.mf" todir=".temp/META-INF"/>
    <copy todir=".temp">
      <fileset dir="${preverify.classes.dir}"/>
      <fileset dir="${obfuscated.classes.dir}">
        <exclude name="**/*.class"/>
      </fileset>
    </copy>
    <exec executable="${basedir}/../kzip/kzip.exe" dir=".temp">
      <arg line="/r /rn /y /q"/>
      <arg value="${basedir}/${dist.dir}/${dist.jar}"/>
      <arg value="*"/>
    </exec>
    <delete includeEmptyDirs="true">
      <fileset dir=".temp"/>
    </delete>
  </target>  

    <target name="copy.template" description="Copy into common dir">
        <echo message="Copy ${basedir}/../templates/${dist.jar}"/>
	<copy file="${dist.dir}/${dist.jar}" todir="${basedir}/../templates" />
	<antcall target="gen.amax" inheritall="true" inheritrefs="true" />
    </target>

    <target name="gen.amax" unless="rebuild.only">
	<echo message="${rebuild.only}"/>
	<exec executable="perl" failonerror="true">
	    <arg value="${basedir}/../gen_amax.pl"/>
	    <arg value="${gen.conf}"/>
	    <arg value="${year}"/>
	    <arg value="${lang}"/>
	    <arg value="${basedir}/../loclist_default.txt"/>
	    <arg value="${basedir}/${dist.dir}/${dist.jar}"/>
	    <arg value="nomessjar"/>
	</exec>
    </target>

</project>
